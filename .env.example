# Public, browser-safe backend base URL. Do not add secrets to this repository.
NEXT_PUBLIC_API_URL=https://bacand-iskra.onrender.com

# Temporary switch. Set to true together with backend CAPTCHA_ENABLED=true
# and rebuild the frontend to restore Cloudflare Turnstile.
NEXT_PUBLIC_CAPTCHA_ENABLED=false

# Public Cloudflare Turnstile site key used only by the registration form.
# Never put the Turnstile secret key in NEXT_PUBLIC_* variables or this repository.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
